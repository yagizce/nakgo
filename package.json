{
  "name": "nakgo",
  "version": "1.0.0",
  "private": true,
  "description": "Yük sahipleri ve taşıyıcıları buluşturan yük pazarı (statik uygulama)",
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "node tools/serve.js",
    "bundle": "node tools/bundle.js",
    "test": "node tools/bundle.js --check && node tools/dev.js lint && node tests/run.js",
    "test:e2e": "python tests/e2e.py",
    "test:shots": "python tests/e2e.py --shots",
    "test:all": "npm test && npm run test:e2e",
    "lint": "node tools/dev.js lint",
    "map": "node tools/dev.js map",
    "logo": "node tools/brand.js",
    "mobile:prepare": "node tools/dev.js www",
    "test:guard": "node tests/guard.js",
    "test:static": "node tests/gate/static.js && python tests/gate/static_html.py",
    "test:gate": "node --test tests/gate/control.test.js",
    "test:browser": "python tests/gate/browser.py",
    "whatsapp:test": "node --test tests/whatsapp/*.test.cjs",
    "whatsapp:parse": "node tools/whatsapp-parse.js",
    "build:vercel": "node tools/bundle.js && node tools/whatsapp-web-output.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
