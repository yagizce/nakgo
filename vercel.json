{
  "cleanUrls": true,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/whatsapp/webhook.mjs": {
      "includeFiles": "src/js/config.js",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-9Yy1RL4gL6cZ4T5KrHIGitcdc+FgO4Ex3JFV2PgiklY=' 'sha256-Hhxp0XQ8A0r428V29O/ilDG7AkTzPxtlydZRrWo81JQ=' https://cdn.jsdelivr.net; style-src 'self' 'sha256-4wlUhBq8BIms/RnGDjh0LYN0CB/2DhsNt9M/yMM0OqQ=' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "codex/nakgo-ci-publisher-direct": false,
      "codex/nakgo-trusted-ci": false,
      "codex/nakgo-retire-file-guard": false,
      "codex/nakgo-guard-replay-maintenance": false,
      "codex/nakgo-ci-unlock-safety": false,
      "codex/nakgo-guard-approval": false,
      "nakgo/**": false
    }
  }
}
