{
  "cleanUrls": true,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/whatsapp/webhook.mjs": {
      "includeFiles": "src/js/config.js",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "claude/gate-selftest": false,
      "claude/public-listings": false,
      "claude/auth-config-timeout-fallback": false,
      "codex/nakgo-ci-publisher-direct": false,
      "codex/nakgo-trusted-ci": false,
      "codex/nakgo-retire-file-guard": false,
      "codex/nakgo-guard-replay-maintenance": false,
      "codex/nakgo-ci-unlock-safety": false,
      "codex/nakgo-guard-approval": false
    }
  }
}
