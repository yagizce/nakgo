{
  "version": "v1",
  "description": "Sürümlü istemci API'si. Uçlar yalnız api şemasında fonksiyon; istemci tabloya dokunmaz. v1 içinde yalnız geriye uyumlu değişiklik (yeni isteğe bağlı argüman, yeni alan, yeni fonksiyon). Alan silme, yeniden adlandırma ya da anlam değişikliği v2 gerektirir. Ayrıntı: docs/api/contract-v1.md",
  "schema": "api",
  "naming": "^[a-z][a-z0-9_]*_v1$",
  "function_rules": {
    "returns": "jsonb",
    "security_definer": true,
    "search_path": "",
    "volatility": "v",
    "begin": "private.api_begin('<name>'"
  },
  "response": {
    "single": {
      "keys": [
        "data"
      ]
    },
    "list": {
      "keys": [
        "data",
        "page"
      ],
      "page": [
        "next"
      ],
      "next": "opak metin imleç ya da null; sayfa boyutu sunucuda sabit"
    }
  },
  "functions": {
    "status_v1": {
      "args": [],
      "roles": [
        "anon",
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "api",
        "enabled",
        "server_time"
      ],
      "works_when_disabled": true
    },
    "listings_v1": {
      "args": [
        [
          "p_cursor",
          "text",
          "optional"
        ],
        [
          "p_kind",
          "text",
          "optional"
        ],
        [
          "p_vehicle",
          "text",
          "optional"
        ],
        [
          "p_body",
          "text",
          "optional"
        ],
        [
          "p_min_amount",
          "numeric",
          "optional"
        ],
        [
          "p_max_amount",
          "numeric",
          "optional"
        ]
      ],
      "roles": [
        "anon",
        "authenticated"
      ],
      "kind": "list",
      "page_size": 50,
      "order": "id desc",
      "item": "listing_item (guest|member)",
      "filters": "tür; araç ve kasa (listing_catalog_v1 değerleri); tonaj aralığı (ton, uçlar dahil). Geçersiz değer invalid_argument"
    },
    "listing_v1": {
      "args": [
        [
          "p_id",
          "bigint"
        ]
      ],
      "roles": [
        "anon",
        "authenticated"
      ],
      "kind": "single",
      "item": "listing_item (guest|member+photo)",
      "errors": [
        "invalid_argument",
        "not_found"
      ]
    },
    "my_listings_v1": {
      "args": [
        [
          "p_cursor",
          "text",
          "optional"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "list",
      "page_size": 50,
      "order": "id desc",
      "item": "listing_item (member)"
    },
    "profile_v1": {
      "args": [],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "display_name",
        "account_type",
        "city",
        "about",
        "phone"
      ],
      "null_when": "profil satırı yok"
    },
    "favorites_v1": {
      "args": [
        [
          "p_cursor",
          "text",
          "optional"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "list",
      "page_size": 50,
      "order": "listing_id desc",
      "item": [
        "listing_id",
        "available",
        "listing"
      ],
      "listing": "listing_item (member) ya da null"
    },
    "favorite_ids_v1": {
      "args": [
        [
          "p_cursor",
          "text",
          "optional"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "list",
      "page_size": 200,
      "order": "listing_id desc",
      "item": "listing_id (sayı)"
    },
    "route_alerts_v1": {
      "args": [
        [
          "p_cursor",
          "text",
          "optional"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "list",
      "page_size": 20,
      "order": "id desc",
      "item": [
        "id",
        "kind",
        "from",
        "to",
        "vehicle",
        "body",
        "active",
        "seen_at",
        "created_at"
      ]
    },
    "listing_create_v1": {
      "args": [
        [
          "p_request_id",
          "uuid"
        ],
        [
          "p_listing",
          "jsonb"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "listing",
        "created"
      ],
      "listing": "listing_item (member+photo)",
      "input": "kind (zorunlu) + yazılabilir ilan alanları; amount JSON sayı, en fazla 3 ondalık (yazıldığı biçimiyle) ve amount_unit=\"ton\" zorunlu; vehicle/body katalogdan; bilinmeyen alan invalid_argument",
      "idempotent": "aynı p_request_id 24 saat içinde aynı ilanı döner (created=false); farklı gövde conflict",
      "errors": [
        "invalid_argument",
        "limit_reached",
        "conflict",
        "not_found",
        "account_suspended"
      ]
    },
    "listing_update_v1": {
      "args": [
        [
          "p_id",
          "bigint"
        ],
        [
          "p_revision",
          "bigint"
        ],
        [
          "p_changes",
          "jsonb"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "listing"
      ],
      "listing": "listing_item (member+photo)",
      "revision": "ilanın son okunan revision değeri (tamsayı, yalnız sahibine döner); farklıysa conflict, hiçbir şey yazılmaz",
      "errors": [
        "invalid_argument",
        "not_found",
        "conflict",
        "limit_reached",
        "not_allowed",
        "account_suspended"
      ],
      "input": "yazılabilir alanlar + status; amount verilirse JSON sayı, en fazla 3 ondalık ve amount_unit=\"ton\" zorunlu"
    },
    "listing_close_v1": {
      "args": [
        [
          "p_id",
          "bigint"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "listing",
        "changed"
      ],
      "idempotent": "zaten kapalıysa changed=false",
      "errors": [
        "invalid_argument",
        "not_found",
        "account_suspended"
      ]
    },
    "profile_update_v1": {
      "args": [
        [
          "p_changes",
          "jsonb"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "display_name",
        "account_type",
        "city",
        "about",
        "phone"
      ],
      "input": "display_name (≤60), account_type (carrier|owner), city (≤40), about (≤200), phone (05XXXXXXXXX ya da boş); metin, kırpılır",
      "errors": [
        "invalid_argument",
        "account_suspended"
      ]
    },
    "favorite_add_v1": {
      "args": [
        [
          "p_listing_id",
          "bigint"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "listing_id",
        "saved"
      ],
      "idempotent": true,
      "errors": [
        "invalid_argument",
        "not_found",
        "account_suspended"
      ]
    },
    "favorite_remove_v1": {
      "args": [
        [
          "p_listing_id",
          "bigint"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "listing_id",
        "saved"
      ],
      "idempotent": true,
      "errors": [
        "invalid_argument"
      ]
    },
    "route_alert_create_v1": {
      "args": [
        [
          "p_kind",
          "text"
        ],
        [
          "p_from",
          "text",
          "optional"
        ],
        [
          "p_to",
          "text",
          "optional"
        ],
        [
          "p_vehicle",
          "text",
          "optional"
        ],
        [
          "p_body",
          "text",
          "optional"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "alert",
        "created"
      ],
      "alert": "route_alerts_v1 öğesi",
      "idempotent": "aynı uyarı varsa onu döner (created=false)",
      "errors": [
        "invalid_argument",
        "limit_reached",
        "account_suspended"
      ],
      "vehicle": "p_vehicle ve p_body verilirse katalogdaki değerlerden biri"
    },
    "route_alert_update_v1": {
      "args": [
        [
          "p_id",
          "bigint"
        ],
        [
          "p_active",
          "boolean"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "alert"
      ],
      "idempotent": true,
      "errors": [
        "invalid_argument",
        "not_found",
        "account_suspended"
      ]
    },
    "route_alert_delete_v1": {
      "args": [
        [
          "p_id",
          "bigint"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "id",
        "removed"
      ],
      "idempotent": "yoksa removed=false",
      "errors": [
        "invalid_argument"
      ]
    },
    "route_alerts_seen_v1": {
      "args": [],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "updated"
      ]
    },
    "listing_contact_v1": {
      "args": [
        [
          "p_id",
          "bigint"
        ],
        [
          "p_channel",
          "text",
          "optional"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "phone",
        "limited"
      ],
      "limit": "30 farklı ilan/60 dk, 100/24 saat (v0 nakgo_listing_contact); aşımda phone=null, limited=true",
      "errors": [
        "invalid_argument",
        "not_found",
        "account_suspended"
      ]
    },
    "account_delete_v1": {
      "args": [],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "deleted"
      ],
      "idempotent": true,
      "errors": [
        "not_allowed"
      ]
    },
    "listing_catalog_v1": {
      "args": [],
      "roles": [
        "anon",
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "vehicles",
        "bodies",
        "amount"
      ],
      "amount": "{unit:\"ton\", min_exclusive:0, max:9007199254740991, max_decimals:3}"
    },
    "report_create_v1": {
      "args": [
        [
          "p_listing_id",
          "bigint"
        ],
        [
          "p_subject",
          "text"
        ],
        [
          "p_reason",
          "text"
        ],
        [
          "p_note",
          "text",
          "optional"
        ]
      ],
      "roles": [
        "authenticated"
      ],
      "kind": "single",
      "data": [
        "report",
        "created"
      ],
      "report": [
        "id",
        "subject",
        "listing_id",
        "reason",
        "status",
        "created_at"
      ],
      "input": "subject: listing|account (hesap, ilanın sahibi; sunucuda çözülür). reason: fake|fraud|inappropriate|wrong_info|other. note ≤200 (isteğe bağlı)",
      "idempotent": "aynı kişinin aynı ilan/hesap için açık şikâyeti varsa onu döner, created=false",
      "limit": "kişi başına 10 yeni şikâyet/saat, 30/24 saat",
      "errors": [
        "invalid_argument",
        "not_found",
        "not_allowed",
        "limit_reached",
        "account_suspended",
        "conflict"
      ]
    }
  },
  "errors": {
    "auth_required": {
      "sqlstate": "42501",
      "http": 401
    },
    "account_unverified": {
      "sqlstate": "42501",
      "http": 403
    },
    "account_suspended": {
      "sqlstate": "42501",
      "http": 403
    },
    "admin_required": {
      "sqlstate": "42501",
      "http": 403
    },
    "invalid_argument": {
      "sqlstate": "22023",
      "http": 400
    },
    "invalid_cursor": {
      "sqlstate": "22023",
      "http": 400
    },
    "not_found": {
      "sqlstate": "PT404",
      "http": 404
    },
    "conflict": {
      "sqlstate": "PT409",
      "http": 409
    },
    "api_disabled": {
      "sqlstate": "PT503",
      "http": 503
    },
    "limit_reached": {
      "sqlstate": "PT429",
      "http": 429
    },
    "not_allowed": {
      "sqlstate": "42501",
      "http": 403
    },
    "internal_error": {
      "sqlstate": "XX000",
      "http": 500
    }
  },
  "usage_columns": [
    "hour",
    "version",
    "fn",
    "shard",
    "calls"
  ],
  "listing_item": {
    "guest": [
      "id",
      "kind",
      "from",
      "to",
      "vehicle",
      "body",
      "amount",
      "cargo",
      "items",
      "date",
      "status",
      "created_at",
      "has_photo"
    ],
    "member": [
      "id",
      "kind",
      "from",
      "to",
      "vehicle",
      "body",
      "amount",
      "cargo",
      "items",
      "date",
      "status",
      "created_at",
      "has_photo",
      "owner_label",
      "note",
      "mine",
      "expires_at",
      "updated_at",
      "contact_allowed",
      "revision"
    ],
    "detail_member_extra": [
      "photo"
    ],
    "place": [
      "city",
      "district"
    ],
    "date": [
      "on",
      "until",
      "time",
      "text"
    ],
    "never": [
      "contact_phone",
      "phone",
      "owner_id",
      "redacted_at",
      "image_data"
    ],
    "revision": "yalnız kendi ilanında tamsayı, diğerlerinde null; her güncellemede 1 artar",
    "amount": "ton (yük ilanında ağırlık, boş araç ilanında boş kapasite)"
  }
}
